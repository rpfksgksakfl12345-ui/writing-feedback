generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  PENDING
  REVIEWED
}

enum InputType {
  TYPED
  PHOTO
}

enum OcrStatus {
  NONE
  PROCESSING
  DONE
  FAILED
}

model User {
  id                 Int             @id @default(autoincrement())
  email              String          @unique
  password           String
  name               String
  role               Role
  grade              Int?
  createdAt          DateTime        @default(now())
  topics             Topic[]
  submissions        Submission[]
  teachingClassrooms Classroom[]
  studentProfile     StudentProfile?
}

model Classroom {
  id                  Int              @id @default(autoincrement())
  name                String
  grade               Int
  classCode           String           @unique
  neisOfficeCode      String?
  neisOfficeName      String?
  neisSchoolCode      String?
  neisSchoolName      String?
  neisSchoolLevel     String?
  neisSchoolAddress   String?
  neisSchoolHomepage  String?
  teacher             User             @relation(fields: [teacherId], references: [id])
  teacherId           Int
  students            StudentProfile[]
  topics              Topic[]
  submissions         Submission[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model StudentProfile {
  id                     Int       @id @default(autoincrement())
  user                   User      @relation(fields: [userId], references: [id])
  userId                 Int       @unique
  classroom              Classroom @relation(fields: [classroomId], references: [id])
  classroomId            Int
  studentNumber          Int
  classroomLoginPassword String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([classroomId, studentNumber])
}

model Topic {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  grade       Int
  createdAt   DateTime     @default(now())
  teacher     User         @relation(fields: [teacherId], references: [id])
  teacherId   Int
  classroom   Classroom?   @relation(fields: [classroomId], references: [id])
  classroomId Int?
  submissions Submission[]
}

model Submission {
  id            Int              @id @default(autoincrement())
  inputType     InputType        @default(PHOTO)
  imageUrl      String?
  content       String?
  ocrStatus     OcrStatus        @default(NONE)
  ocrError      String?
  ocrExtractedText String?
  editedExtractedText String?
  extractedText String?
  aiFeedback    String?
  finalFeedback String?
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  student       User             @relation(fields: [studentId], references: [id])
  studentId     Int
  topic         Topic            @relation(fields: [topicId], references: [id])
  topicId       Int
  classroom     Classroom?       @relation(fields: [classroomId], references: [id])
  classroomId   Int?
}
